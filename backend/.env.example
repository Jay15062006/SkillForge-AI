# SkillForge AI Backend Environment Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Hosted Open-Weight AI Inference Provider
# Supported providers:
# - Backboard (e.g., meta-llama/llama-3.1-8b-instruct) -> Base URL: https://app.backboard.io/api
# - Groq (e.g., llama-3.3-70b-versatile, llama-3.1-8b-instant) -> Base URL: https://api.groq.com/openai/v1
# - Together AI (e.g., meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo)
# - Hugging Face Inference API / TGI (e.g., meta-llama/Llama-3.2-3B-Instruct)
# - OpenRouter (e.g., meta-llama/llama-3.3-70b-instruct)
# - Self-hosted vLLM / Ollama (e.g., http://localhost:11434/v1)

INFERENCE_PROVIDER_NAME=backboard
INFERENCE_BASE_URL=https://app.backboard.io/api
INFERENCE_API_KEY=
INFERENCE_MODEL=meta-llama/llama-3.1-8b-instruct
INFERENCE_MAX_TOKENS=2500
INFERENCE_TEMPERATURE=0.2
